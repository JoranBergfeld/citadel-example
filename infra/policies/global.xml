<policies>
  <inbound>
    <set-variable name="caller" value="@{
      if (context.Subscription == null) { return &quot;&quot;; }
      var id = context.Subscription.Id;
      var known = new [] { &quot;operator&quot;, &quot;operator-web&quot;, &quot;candidate-planner&quot;, &quot;evidence-assessor&quot;, &quot;release-reviewer&quot;, &quot;briefing-author&quot; };
      return known.Contains(id) ? id : &quot;&quot;;
    }" />
    <choose>
      <when condition="@(((string)context.Variables[&quot;caller&quot;]) == &quot;&quot; || context.Request.Url.Query.Count &gt; 0 || !new [] { &quot;candidate-planner&quot;, &quot;evidence-assessor&quot;, &quot;release-reviewer&quot;, &quot;briefing-author&quot;, &quot;reference-data&quot;, &quot;model&quot; }.Contains(context.Api.Id))">
        <return-response>
          <set-status code="403" reason="Unknown caller" />
          <set-header name="X-Citadel-Denial" exists-action="override"><value>unknown_caller</value></set-header>
          <set-header name="X-Citadel-Gateway-Request-Id" exists-action="override"><value>@(context.RequestId.ToString("N"))</value></set-header>
        </return-response>
      </when>
    </choose>
    <set-header name="X-Citadel-Caller" exists-action="override"><value>@((string)context.Variables["caller"])</value></set-header>
    <set-header name="X-Forwarded-Client-Cert" exists-action="delete" />
    <set-header name="X-Client-Cert" exists-action="delete" />
    <set-header name="X-Client-Certificate" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
  </inbound>
  <backend><forward-request timeout="180" buffer-response="false" /></backend>
  <outbound>
    <set-header name="X-Citadel-Denial" exists-action="delete" />
    <set-header name="X-Citadel-Gateway-Request-Id" exists-action="override"><value>@(context.RequestId.ToString("N"))</value></set-header>
  </outbound>
  <on-error />
</policies>
